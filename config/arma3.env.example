# Core paths
ARMA_USER=arma3
ARMA_HOME=/home/arma3
SERVER_DIR=/home/arma3/server
STEAMCMD_DIR=/home/arma3/steamcmd
WORKSHOP_DIR=/home/arma3/workshop
BACKUP_DIR=/home/arma3/backups
STATE_DIR=/home/arma3/state
MODS_FILE=/etc/arma3/mods.csv

# Steam account used by SteamCMD. Run "sudo -u arma3 /opt/arma3-control/scripts/arma3ctl steam-login"
# once interactively so Steam Guard and credentials are cached. Do not store the password here.
STEAM_USER=

# Workshop download behavior. Failed items are retried and reported after all
# remaining items have been processed. Validation is optional because it can
# cause problems with some large Workshop items.
WORKSHOP_RETRIES=4
WORKSHOP_RETRY_DELAY=30
WORKSHOP_ITEM_TIMEOUT=3h
WORKSHOP_VALIDATE=0
FAILED_MODS_FILE=/home/arma3/state/failed-mods.csv

# Arma server settings
SERVER_PORT=2302
PROFILE_NAME=server
SERVER_CONFIG=server.cfg
BASIC_CONFIG=basic.cfg
SERVER_UNIT=arma3-server.service
STRICT_MOD_CHECK=1

# Optional server-side-only mods, separated by semicolons and relative to SERVER_DIR.
SERVER_MODS=

# Additional startup arguments. Keep this empty until a parameter is actually required.
ADDITIONAL_ARGS=

# Retention for configuration/mission/local-mod backups
BACKUP_RETENTION_DAYS=14
