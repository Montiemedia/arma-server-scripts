#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

CONTROL_ROOT="${CONTROL_ROOT:-/opt/arma3-control}"
ENV_FILE="${ARMA_ENV_FILE:-/etc/arma3/arma3.env}"
[[ -r "$ENV_FILE" ]] || { echo "Konfiguration fehlt: $ENV_FILE" >&2; exit 1; }
# shellcheck disable=SC1090
source "$ENV_FILE"

: "${ARMA_USER:=arma3}"
: "${ARMA_HOME:=/home/arma3}"
: "${SERVER_DIR:=/home/arma3/server}"
: "${STEAMCMD_DIR:=/home/arma3/steamcmd}"
: "${WORKSHOP_DIR:=/home/arma3/workshop}"
: "${BACKUP_DIR:=/home/arma3/backups}"
: "${STATE_DIR:=/home/arma3/state}"
: "${MODS_FILE:=/etc/arma3/mods.csv}"
: "${MISSION_DIR:=$SERVER_DIR/mpmissions}"
: "${SERVER_UNIT:=arma3-server.service}"
: "${BACKUP_RETENTION_DAYS:=14}"
: "${FAILED_MODS_FILE:=$STATE_DIR/failed-mods.csv}"
: "${LOCK_FILE:=/run/lock/arma3-control.lock}"
: "${DEPOTDOWNLOADER_DIR:=$ARMA_HOME/depotdownloader}"
: "${DEPOT_WORKSHOP_DIR:=$ARMA_HOME/depot-workshop}"
: "${DEPOTDOWNLOADER_VERSION:=3.4.0}"
: "${DEPOTDOWNLOADER_FALLBACK:=1}"
: "${DEPOTDOWNLOADER_TIMEOUT:=6h}"
: "${DEPOTDOWNLOADER_VALIDATE:=1}"

declare -a MOD_FAILURE_NAMES=()
declare -a MOD_FAILURE_IDS=()
declare -a MOD_FAILURE_TARGETS=()
declare -a MOD_FAILURE_STAGES=()
declare -a MOD_FAILURE_REASONS=()
declare -a MOD_UPDATED_NAMES=()
declare -a MOD_UPDATED_IDS=()
declare -A WORKSHOP_SOURCE_OVERRIDES=()
DOWNLOAD_ERROR=""
DEPOT_ERROR=""
MOD_UPDATE_RESULT=0

log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
die() { printf 'FEHLER: %s\n' "$*" >&2; exit 1; }

as_arma3() {
    if [[ "$(id -un)" == "$ARMA_USER" ]]; then
        env HOME="$ARMA_HOME" "$@"
    else
        runuser -u "$ARMA_USER" -- env HOME="$ARMA_HOME" "$@"
    fi
}

require_root() {
    [[ $EUID -eq 0 ]] || die "Dieser Befehl muss als root oder über sudo laufen."
}

acquire_maintenance_lock() {
    require_root
    exec 9>"$LOCK_FILE"
    flock -n 9 || die "Eine andere Arma-3-Wartungsaktion läuft bereits."
}

ensure_dirs() {
    require_root
    install -d -o "$ARMA_USER" -g "$ARMA_USER" -m 0750 \
        "$STEAMCMD_DIR" "$SERVER_DIR" "$SERVER_DIR/mods" \
        "$WORKSHOP_DIR" "$DEPOTDOWNLOADER_DIR" "$DEPOT_WORKSHOP_DIR" \
        "$BACKUP_DIR" "$STATE_DIR" \
        "$ARMA_HOME/.local" "$ARMA_HOME/.local/share" \
        "$ARMA_HOME/.local/share/IsolatedStorage" \
        "$ARMA_HOME/.local/share/Arma 3" \
        "$ARMA_HOME/.local/share/Arma 3 - Other Profiles"

    local legacy_mission_dir="$SERVER_DIR/MPMissions"
    if [[ "$MISSION_DIR" == "$SERVER_DIR/mpmissions" && -d "$legacy_mission_dir" ]]; then
        if [[ ! -e "$MISSION_DIR" ]]; then
            log "Übernehme bisherigen Missionsordner: $legacy_mission_dir -> $MISSION_DIR"
            mv -- "$legacy_mission_dir" "$MISSION_DIR"
        else
            log "Übernehme noch fehlende Missionen aus $legacy_mission_dir ..."
            rsync -a --ignore-existing "$legacy_mission_dir/" "$MISSION_DIR/"
        fi
    fi
    install -d -o "$ARMA_USER" -g "$ARMA_USER" -m 0750 "$MISSION_DIR"
}

ensure_steamcmd() {
    ensure_dirs
    if [[ ! -x "$STEAMCMD_DIR/steamcmd.sh" ]]; then
        log "Installiere SteamCMD ..."
        local tmp
        tmp=$(as_arma3 mktemp -p "$STEAMCMD_DIR" .steamcmd.XXXXXX.tar.gz)
        if ! as_arma3 curl -fsSL \
            https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz \
            -o "$tmp"; then
            rm -f "$tmp"
            die "SteamCMD konnte nicht heruntergeladen werden."
        fi
        if ! as_arma3 tar -xzf "$tmp" -C "$STEAMCMD_DIR"; then
            rm -f "$tmp"
            die "SteamCMD-Archiv konnte nicht entpackt werden."
        fi
        rm -f "$tmp"
    fi
}

steam_login_args() {
    if [[ -n "${STEAM_USER:-}" ]]; then
        printf '%s\0%s\0' '+login' "$STEAM_USER"
    else
        printf '%s\0%s\0' '+login' 'anonymous'
    fi
}

steam_update_server() {
    ensure_steamcmd
    local -a login_args=()
    while IFS= read -r -d '' token; do login_args+=("$token"); done < <(steam_login_args)
    timeout --signal=INT --kill-after=30s 1h \
        runuser -u "$ARMA_USER" -- env HOME="$ARMA_HOME" "$STEAMCMD_DIR/steamcmd.sh" \
        +force_install_dir "$SERVER_DIR" \
        "${login_args[@]}" \
        +app_update 233780 validate \
        +quit
}

valid_mod_source() {
    local candidate="$1" first_pbo
    [[ -d "$candidate" ]] || return 1
    first_pbo=$(find "$candidate" -type f -iname '*.pbo' -print -quit 2>/dev/null)
    [[ -n "$first_pbo" ]]
}

install_depotdownloader() {
    require_root
    ensure_dirs
    [[ "$DEPOTDOWNLOADER_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
        || die "Ungültige DEPOTDOWNLOADER_VERSION: $DEPOTDOWNLOADER_VERSION"
    [[ "$(uname -m)" == "x86_64" ]] \
        || die "DepotDownloader wird von diesem Installer nur auf x86-64 eingerichtet."

    local archive stage url
    archive=$(mktemp)
    stage=$(mktemp -d)
    url="https://github.com/SteamRE/DepotDownloader/releases/download/DepotDownloader_${DEPOTDOWNLOADER_VERSION}/DepotDownloader-linux-x64.zip"

    log "Installiere DepotDownloader $DEPOTDOWNLOADER_VERSION ..."
    if ! curl -fsSL --retry 3 --connect-timeout 15 "$url" -o "$archive"; then
        rm -f -- "$archive"
        rm -rf -- "$stage"
        die "DepotDownloader konnte nicht heruntergeladen werden."
    fi
    if ! unzip -q "$archive" -d "$stage"; then
        rm -f -- "$archive"
        rm -rf -- "$stage"
        die "DepotDownloader-Archiv konnte nicht entpackt werden."
    fi
    if [[ ! -f "$stage/DepotDownloader" ]]; then
        rm -f -- "$archive"
        rm -rf -- "$stage"
        die "DepotDownloader fehlt im heruntergeladenen Archiv."
    fi

    rsync -a --delete "$stage/" "$DEPOTDOWNLOADER_DIR/"
    chown -R "$ARMA_USER:$ARMA_USER" "$DEPOTDOWNLOADER_DIR"
    chmod 0750 "$DEPOTDOWNLOADER_DIR/DepotDownloader"
    rm -f -- "$archive"
    rm -rf -- "$stage"
    log "DepotDownloader ist einsatzbereit: $DEPOTDOWNLOADER_DIR/DepotDownloader"
}

steam_workshop_source() {
    local id="$1" candidate
    for candidate in \
        "$WORKSHOP_DIR/steamapps/workshop/content/107410/$id" \
        "$STEAMCMD_DIR/steamapps/workshop/content/107410/$id" \
        "$SERVER_DIR/steamapps/workshop/content/107410/$id"; do
        valid_mod_source "$candidate" && { printf '%s\n' "$candidate"; return 0; }
    done
    return 1
}

workshop_source() {
    local id="$1" candidate
    candidate=${WORKSHOP_SOURCE_OVERRIDES[$id]:-}
    if [[ -n "$candidate" ]] && valid_mod_source "$candidate"; then
        printf '%s\n' "$candidate"
        return 0
    fi
    candidate="$DEPOT_WORKSHOP_DIR/$id"
    if valid_mod_source "$candidate"; then
        printf '%s\n' "$candidate"
        return 0
    fi
    steam_workshop_source "$id"
}

depotdownloader_available() {
    [[ "$DEPOTDOWNLOADER_FALLBACK" == "1" ]] \
        && [[ -n "${STEAM_USER:-}" ]] \
        && [[ -x "$DEPOTDOWNLOADER_DIR/DepotDownloader" ]]
}

download_with_depotdownloader() {
    local name="$1" workshop_id="$2"
    local target_dir="$DEPOT_WORKSHOP_DIR/$workshop_id"
    local log_file depot_status first_pbo
    local -a validate_arg=()

    DEPOT_ERROR=""
    depotdownloader_available || {
        DEPOT_ERROR="DepotDownloader ist nicht verfügbar oder deaktiviert"
        return 1
    }
    if [[ "$DEPOTDOWNLOADER_VALIDATE" == "1" ]]; then
        validate_arg=(-validate)
    fi

    install -d -o "$ARMA_USER" -g "$ARMA_USER" -m 0750 "$target_dir"
    log "Lade $name ($workshop_id) mit DepotDownloader ..."
    log_file=$(mktemp)

    set +e
    timeout --signal=INT --kill-after=30s "$DEPOTDOWNLOADER_TIMEOUT" \
        runuser -u "$ARMA_USER" -- env \
        HOME="$ARMA_HOME" \
        XDG_DATA_HOME="$ARMA_HOME/.local/share" \
        DOTNET_CLI_HOME="$ARMA_HOME" \
        "$DEPOTDOWNLOADER_DIR/DepotDownloader" \
        -app 107410 \
        -pubfile "$workshop_id" \
        -username "$STEAM_USER" \
        -remember-password \
        -no-mobile \
        -dir "$target_dir" \
        "${validate_arg[@]}" 2>&1 | tee "$log_file"
    depot_status=${PIPESTATUS[0]}
    set -e

    first_pbo=$(find "$target_dir" -type f -iname '*.pbo' -print -quit 2>/dev/null)
    rm -f "$log_file"

    if (( depot_status == 0 )) && [[ -n "$first_pbo" ]]; then
        WORKSHOP_SOURCE_OVERRIDES["$workshop_id"]="$target_dir"
        log "DepotDownloader erfolgreich: $name ($workshop_id)"
        return 0
    fi

    if (( depot_status == 124 || depot_status == 137 )); then
        DEPOT_ERROR="DepotDownloader-Zeitüberschreitung nach $DEPOTDOWNLOADER_TIMEOUT"
    elif (( depot_status != 0 )); then
        DEPOT_ERROR="DepotDownloader endete mit Exit-Code $depot_status"
    else
        DEPOT_ERROR="DepotDownloader lieferte keine PBO-Dateien"
    fi
    return 1
}

service_was_active=0
stop_for_maintenance() {
    require_root
    service_was_active=0
    if systemctl is-active --quiet "$SERVER_UNIT"; then
        service_was_active=1
        log "Stoppe $SERVER_UNIT für Wartung ..."
        systemctl stop "$SERVER_UNIT"
    fi
}

restart_after_maintenance() {
    if (( service_was_active )); then
        log "Starte $SERVER_UNIT erneut ..."
        systemctl start "$SERVER_UNIT"
    fi
}

sync_keys() {
    require_root
    local keys_dir="$SERVER_DIR/keys"
    local state_file="$STATE_DIR/managed-keys.txt"
    install -d -o "$ARMA_USER" -g "$ARMA_USER" -m 0750 "$keys_dir"

    if [[ -f "$state_file" ]]; then
        while IFS= read -r key; do
            [[ "$key" =~ ^[A-Za-z0-9_.+-]+\.bikey$ ]] && rm -f "$keys_dir/$key"
        done < "$state_file"
    fi

    : > "$state_file"
    chown "$ARMA_USER:$ARMA_USER" "$state_file"

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" ]] && continue
        [[ "$enabled" == "1" ]] || continue
        local mod_dir="$SERVER_DIR/mods/$target"
        [[ -d "$mod_dir" ]] || continue
        while IFS= read -r -d '' key_path; do
            local key_name
            key_name=$(basename "$key_path")
            if [[ -e "$keys_dir/$key_name" ]] && ! cmp -s "$key_path" "$keys_dir/$key_name"; then
                die "Unterschiedliche Keys mit gleichem Namen: $key_name"
            fi
            install -o "$ARMA_USER" -g "$ARMA_USER" -m 0640 "$key_path" "$keys_dir/$key_name"
            grep -qxF "$key_name" "$state_file" || echo "$key_name" >> "$state_file"
        done < <(find "$mod_dir" -type f -iname '*.bikey' -print0)
    done < "$MODS_FILE"

    log "Mod-Keys synchronisiert: $(wc -l < "$state_file")"
}

csv_quote() {
    local value="$1"
    value=${value//$'\r'/ }
    value=${value//$'\n'/ }
    value=${value//\"/\"\"}
    printf '"%s"' "$value"
}

reset_mod_failures() {
    MOD_FAILURE_NAMES=()
    MOD_FAILURE_IDS=()
    MOD_FAILURE_TARGETS=()
    MOD_FAILURE_STAGES=()
    MOD_FAILURE_REASONS=()
    MOD_UPDATED_NAMES=()
    MOD_UPDATED_IDS=()
    WORKSHOP_SOURCE_OVERRIDES=()

    printf '%s\n' 'timestamp,name,workshop_id,target,stage,reason' > "$FAILED_MODS_FILE"
    chown "$ARMA_USER:$ARMA_USER" "$FAILED_MODS_FILE"
    chmod 0640 "$FAILED_MODS_FILE"
}

print_mod_update_summary() {
    local count=${#MOD_UPDATED_NAMES[@]}
    local index

    printf '\n=== Erfolgreich heruntergeladene Mods (%d) ===\n' "$count"
    for ((index=0; index<count; index++)); do
        printf '  %2d) %s (%s)\n' \
            "$((index + 1))" \
            "${MOD_UPDATED_NAMES[$index]}" \
            "${MOD_UPDATED_IDS[$index]}"
    done
    (( count > 0 )) || printf '  Keine Mods erfolgreich heruntergeladen.\n'
}

record_mod_failure() {
    local name="$1" workshop_id="$2" target="$3" stage="$4" reason="$5"

    printf '%s,%s,%s,%s,%s,%s\n' \
        "$(csv_quote "$(date '+%F %T')")" \
        "$(csv_quote "$name")" \
        "$(csv_quote "$workshop_id")" \
        "$(csv_quote "$target")" \
        "$(csv_quote "$stage")" \
        "$(csv_quote "$reason")" >> "$FAILED_MODS_FILE"

    MOD_FAILURE_NAMES+=("$name")
    MOD_FAILURE_IDS+=("$workshop_id")
    MOD_FAILURE_TARGETS+=("$target")
    MOD_FAILURE_STAGES+=("$stage")
    MOD_FAILURE_REASONS+=("$reason")
}

print_mod_failure_summary() {
    local count=${#MOD_FAILURE_NAMES[@]}
    local index

    if (( count == 0 )); then
        log "Alle Workshop-Mods wurden erfolgreich verarbeitet."
        log "Fehlerdatei (nur Kopfzeile): $FAILED_MODS_FILE"
        return 0
    fi

    printf '\n=== Fehlerhafte Mods (%d) ===\n' "$count"
    for ((index=0; index<count; index++)); do
        printf '  - %s (%s) - %s: %s\n' \
            "${MOD_FAILURE_NAMES[$index]}" \
            "${MOD_FAILURE_IDS[$index]}" \
            "${MOD_FAILURE_STAGES[$index]}" \
            "${MOD_FAILURE_REASONS[$index]}"
    done
    printf '\nFehlerdatei: %s\n' "$FAILED_MODS_FILE"
    printf 'Alle übrigen Mods wurden weiterverarbeitet.\n'
}

download_workshop_item() {
    local name="$1" workshop_id="$2"
    shift 2
    local -a login_args=("$@")
    local retries="${WORKSHOP_RETRIES:-4}"
    local retry_delay="${WORKSHOP_RETRY_DELAY:-30}"
    local item_timeout="${WORKSHOP_ITEM_TIMEOUT:-3h}"
    local attempt log_file steam_status last_reason depot_reason="" source_dir
    local depot_attempted=0
    local -a validate_arg=()

    [[ "$retries" =~ ^[1-9][0-9]*$ ]] \
        || die "WORKSHOP_RETRIES muss eine positive ganze Zahl sein."
    [[ "$retry_delay" =~ ^[0-9]+$ ]] \
        || die "WORKSHOP_RETRY_DELAY muss eine nichtnegative ganze Zahl sein."
    if [[ "${WORKSHOP_VALIDATE:-0}" == "1" ]]; then
        validate_arg=(validate)
    fi

    DOWNLOAD_ERROR=""
    last_reason="Unbekannter SteamCMD-Fehler"

    # Mods, die bereits einmal über DepotDownloader geladen wurden, werden bei
    # späteren Updates direkt damit geprüft. So entstehen nicht bei jedem Lauf
    # erneut vier bekannte SteamCMD-Fehler.
    if depotdownloader_available \
        && valid_mod_source "$DEPOT_WORKSHOP_DIR/$workshop_id"; then
        depot_attempted=1
        if download_with_depotdownloader "$name" "$workshop_id"; then
            return 0
        fi
        depot_reason="$DEPOT_ERROR"
        log "DepotDownloader fehlgeschlagen: $depot_reason. Versuche SteamCMD ..."
    fi

    for ((attempt=1; attempt<=retries; attempt++)); do
        log "Lade $name ($workshop_id), Versuch $attempt/$retries ..."
        log_file=$(mktemp)

        set +e
        timeout --signal=INT --kill-after=30s "$item_timeout" \
            runuser -u "$ARMA_USER" -- env HOME="$ARMA_HOME" "$STEAMCMD_DIR/steamcmd.sh" \
            +force_install_dir "$WORKSHOP_DIR" \
            "${login_args[@]}" \
            +workshop_download_item 107410 "$workshop_id" "${validate_arg[@]}" \
            +quit 2>&1 | tee "$log_file"
        steam_status=${PIPESTATUS[0]}
        set -e

        if (( steam_status == 0 )) \
            && grep -Fq "Success. Downloaded item $workshop_id" "$log_file"; then
            if source_dir=$(steam_workshop_source "$workshop_id"); then
                WORKSHOP_SOURCE_OVERRIDES["$workshop_id"]="$source_dir"
                rm -f "$log_file"
                log "Download erfolgreich: $name ($workshop_id)"
                return 0
            fi
        fi

        if (( steam_status == 124 || steam_status == 137 )); then
            last_reason="Zeitüberschreitung nach $item_timeout"
        elif (( steam_status != 0 )); then
            last_reason="SteamCMD endete mit Exit-Code $steam_status"
        elif grep -Fq "Success. Downloaded item $workshop_id" "$log_file"; then
            last_reason="SteamCMD meldete Erfolg, aber das Downloadverzeichnis fehlt"
        else
            last_reason="SteamCMD meldete keinen erfolgreichen Download"
        fi

        rm -f "$log_file"
        if (( attempt < retries )); then
            log "Download fehlgeschlagen: $last_reason. Neuer Versuch in ${retry_delay}s ..."
            sleep "$retry_delay"
        fi
    done

    # Wenn SteamCMD den Workshop-Mod nicht laden kann, wird automatisch der
    # bereits eingerichtete DepotDownloader als zweiter Downloadweg verwendet.
    if (( depot_attempted == 0 )) && depotdownloader_available; then
        depot_attempted=1
        if download_with_depotdownloader "$name" "$workshop_id"; then
            return 0
        fi
        depot_reason="$DEPOT_ERROR"
    fi

    DOWNLOAD_ERROR="$last_reason nach $retries Versuchen"
    if [[ -n "$depot_reason" ]]; then
        DOWNLOAD_ERROR+="; $depot_reason"
    elif (( depot_attempted == 0 )); then
        DOWNLOAD_ERROR+="; DepotDownloader-Fallback nicht verfügbar"
    fi
    log "FEHLER: $name ($workshop_id) konnte nicht geladen werden. Der nächste Mod wird versucht."
    return 1
}

sync_workshop_item() {
    local name="$1" workshop_id="$2" target="$3"
    local source_dir target_dir

    if ! source_dir=$(workshop_source "$workshop_id"); then
        DOWNLOAD_ERROR="Downloadverzeichnis fehlt"
        return 1
    fi

    target_dir="$SERVER_DIR/mods/$target"
    log "Synchronisiere $name -> $target"

    if ! install -d -o "$ARMA_USER" -g "$ARMA_USER" -m 0750 "$target_dir"; then
        DOWNLOAD_ERROR="Zielordner konnte nicht angelegt werden"
        return 1
    fi
    if ! rsync -a --delete "$source_dir/" "$target_dir/"; then
        DOWNLOAD_ERROR="rsync ist fehlgeschlagen"
        return 1
    fi
    if ! chown -R "$ARMA_USER:$ARMA_USER" "$target_dir"; then
        DOWNLOAD_ERROR="Besitzrechte konnten nicht gesetzt werden"
        return 1
    fi
    if ! as_arma3 python3 "$CONTROL_ROOT/scripts/lowercase_tree.py" "$target_dir"; then
        DOWNLOAD_ERROR="Dateinamen konnten nicht kleingeschrieben werden"
        return 1
    fi

    return 0
}

update_mods_core() {
    require_root
    ensure_steamcmd

    local -a login_args=()
    local -A failed_download_ids=()
    local mod_count=0
    local name type workshop_id target enabled
    local result=0
    while IFS= read -r -d '' token; do login_args+=("$token"); done < <(steam_login_args)

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" ]] && continue
        [[ "$enabled" == "1" && "$type" == "workshop" ]] || continue
        [[ "$workshop_id" =~ ^[0-9]+$ ]] || die "Ungültige Workshop-ID für $name"
        [[ "$target" =~ ^@[a-z0-9_+.-]+$ ]] || die "Ungültiger Zielordner für $name: $target"
        ((mod_count+=1))
    done < "$MODS_FILE"

    (( mod_count > 0 )) || die "Keine aktivierten Workshop-Mods gefunden."
    reset_mod_failures
    log "Aktualisiere $mod_count Workshop-Mods einzeln mit Wiederholungsversuchen ..."

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" ]] && continue
        [[ "$enabled" == "1" && "$type" == "workshop" ]] || continue

        if ! download_workshop_item "$name" "$workshop_id" "${login_args[@]}"; then
            failed_download_ids["$workshop_id"]=1
            record_mod_failure "$name" "$workshop_id" "$target" "download" "$DOWNLOAD_ERROR"
            result=1
        else
            MOD_UPDATED_NAMES+=("$name")
            MOD_UPDATED_IDS+=("$workshop_id")
        fi
    done < "$MODS_FILE"

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" ]] && continue
        [[ "$enabled" == "1" && "$type" == "workshop" ]] || continue
        [[ -z "${failed_download_ids[$workshop_id]:-}" ]] || continue

        if ! sync_workshop_item "$name" "$workshop_id" "$target"; then
            log "FEHLER: $name ($workshop_id) konnte nicht synchronisiert werden. Der nächste Mod wird versucht."
            record_mod_failure "$name" "$workshop_id" "$target" "sync" "$DOWNLOAD_ERROR"
            result=1
        fi
    done < "$MODS_FILE"

    sync_keys
    print_mod_update_summary
    print_mod_failure_summary

    MOD_UPDATE_RESULT=$result
}

remove_workshop_mod() {
    require_root
    ensure_dirs
    local requested_target="$1"
    local name="" type="" workshop_id="" target="" enabled=""
    local found=0 server_mod_dir temporary

    [[ "$requested_target" =~ ^@[a-z0-9_+.-]+$ ]] \
        || die "Ungültiger Modordner: $requested_target"

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" ]] && continue
        if [[ "$type" == "workshop" && "$target" == "$requested_target" ]]; then
            found=1
            break
        fi
    done < "$MODS_FILE"
    (( found == 1 )) || die "Workshop-Mod steht nicht in $MODS_FILE: $requested_target"
    [[ "$workshop_id" =~ ^[0-9]+$ ]] || die "Ungültige Workshop-ID für $name"

    server_mod_dir="$SERVER_DIR/mods/$target"
    case "$server_mod_dir" in
        "$SERVER_DIR"/mods/@*) ;;
        *) die "Unsicherer Modpfad wurde abgelehnt: $server_mod_dir" ;;
    esac

    stop_for_maintenance
    rm -rf -- \
        "${server_mod_dir:?}" \
        "${WORKSHOP_DIR:?}/steamapps/workshop/content/107410/$workshop_id" \
        "${STEAMCMD_DIR:?}/steamapps/workshop/content/107410/$workshop_id" \
        "${SERVER_DIR:?}/steamapps/workshop/content/107410/$workshop_id" \
        "${DEPOT_WORKSHOP_DIR:?}/$workshop_id"

    temporary=$(mktemp)
    awk -F, -v OFS=, -v requested_target="$requested_target" '
        $1 == "name" { print; next }
        $2 == "workshop" && $4 == requested_target { $5 = 0 }
        { print }
    ' "$MODS_FILE" > "$temporary"
    install -o root -g arma3ops -m 0640 "$temporary" "$MODS_FILE"
    rm -f -- "$temporary"

    sync_keys
    log "Workshop-Mod gelöscht und in mods.csv deaktiviert: $name ($target)"
    if (( service_was_active )); then
        log "Der Server bleibt angehalten. Prüfe die Modliste und starte ihn danach bewusst neu."
    fi
}

update_mods() {
    require_root
    stop_for_maintenance
    trap restart_after_maintenance EXIT

    update_mods_core

    trap - EXIT
    restart_after_maintenance
    return "$MOD_UPDATE_RESULT"
}

update_server() {
    require_root
    stop_for_maintenance
    trap restart_after_maintenance EXIT
    steam_update_server
    trap - EXIT
    restart_after_maintenance
}

update_all() {
    require_root
    stop_for_maintenance
    trap restart_after_maintenance EXIT

    steam_update_server
    update_mods_core

    trap - EXIT
    restart_after_maintenance
    return "$MOD_UPDATE_RESULT"
}

backup_server() {
    require_root
    ensure_dirs
    local stamp archive stage
    stamp=$(date '+%Y%m%d_%H%M%S')
    archive="$BACKUP_DIR/arma3_${stamp}.tar.gz"
    stage=$(mktemp -d)
    trap 'rm -rf "$stage"' EXIT

    install -d "$stage/server" "$stage/profile" "$stage/local-mods"
    for item in server.cfg basic.cfg ban.txt bans.txt; do
        [[ -e "$SERVER_DIR/$item" ]] && cp -a "$SERVER_DIR/$item" "$stage/server/"
    done
    [[ -d "$MISSION_DIR" ]] && rsync -a "$MISSION_DIR/" "$stage/server/mpmissions/"
    [[ -d "$ARMA_HOME/.local/share/Arma 3 - Other Profiles" ]] && \
        rsync -a "$ARMA_HOME/.local/share/Arma 3 - Other Profiles/" "$stage/profile/"

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" ]] && continue
        [[ "$type" == "local" ]] || continue
        [[ -d "$SERVER_DIR/mods/$target" ]] && rsync -a "$SERVER_DIR/mods/$target" "$stage/local-mods/"
    done < "$MODS_FILE"

    tar -C "$stage" -czf "$archive" .
    chown "$ARMA_USER:$ARMA_USER" "$archive"
    find "$BACKUP_DIR" -maxdepth 1 -type f -name 'arma3_*.tar.gz' -mtime "+$BACKUP_RETENTION_DAYS" -delete
    log "Backup erstellt: $archive ($(du -h "$archive" | cut -f1))"
}

doctor() {
    local errors=0 warnings=0 uppercase
    echo "=== TF133 Arma 3 Diagnose ==="
    printf 'Server-Unit: '; systemctl is-active "$SERVER_UNIT" 2>/dev/null || true
    printf 'Serververzeichnis: %s\n' "$SERVER_DIR"
    printf 'Speicher: '; df -h "$SERVER_DIR" 2>/dev/null | awk 'NR==2 {print $3 " / " $2 " belegt, " $4 " frei"}' || true

    for file in "$SERVER_DIR/arma3server_x64" "$SERVER_DIR/server.cfg" "$SERVER_DIR/basic.cfg" "$MODS_FILE"; do
        if [[ -e "$file" ]]; then echo "OK: $file"; else echo "FEHLT: $file"; ((errors+=1)); fi
    done

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" || "$enabled" != "1" ]] && continue
        if [[ ! -d "$SERVER_DIR/mods/$target" ]]; then
            echo "MOD FEHLT: $name ($target)"
            ((warnings+=1))
        fi
    done < "$MODS_FILE"

    uppercase=$(find "$SERVER_DIR/mods" -mindepth 1 -name '*[A-Z]*' 2>/dev/null | wc -l || true)
    echo "Pfade mit Großbuchstaben unter mods/: $uppercase"
    (( uppercase > 0 )) && ((warnings+=1))

    if command -v ss >/dev/null; then
        echo "UDP-Ports 2302-2306:"
        ss -lun | awk '$5 ~ /:(2302|2303|2304|2305|2306)$/ {print "  " $0}' || true
    fi

    echo "Ergebnis: $errors Fehler, $warnings Warnungen"
    (( errors == 0 ))
}

usage() {
    cat <<'USAGE'
Verwendung: arma3ctl <Befehl>

  steam-login      SteamCMD interaktiv anmelden und Steam Guard bestätigen
  install-depotdownloader
                   DepotDownloader als Ausweichlösung installieren
  install-server   Dedicated Server installieren oder validieren
  update-server    Server stoppen, aktualisieren und wieder starten
  update-mods      Workshop-Mods aktualisieren, Fehler protokollieren und fortfahren
  update-all       Server und Mods aktualisieren
  sync-keys        Keys der aktivierten Mods synchronisieren
  backup           Konfiguration, Missionen, Profile und lokale Mods sichern
  remove-mod TARGET
                   Workshop-Mod löschen und in mods.csv deaktivieren
  start|stop|restart|status
  logs [ZEILEN]
  doctor           Installation und Modstruktur prüfen
USAGE
}

command="${1:-}"
case "$command" in
    steam-login|install-depotdownloader|install-server|update-server|update-mods|update-all|sync-keys|backup|remove-mod|start|stop|restart)
        acquire_maintenance_lock
        ;;
esac
case "$command" in
    steam-login)
        require_root; ensure_steamcmd
        [[ -n "${STEAM_USER:-}" ]] || die "STEAM_USER zuerst in $ENV_FILE setzen."
        as_arma3 "$STEAMCMD_DIR/steamcmd.sh" +login "$STEAM_USER" +quit
        ;;
    install-depotdownloader) install_depotdownloader ;;
    install-server) require_root; steam_update_server ;;
    update-server) update_server ;;
    update-mods) update_mods ;;
    update-all) update_all ;;
    sync-keys) sync_keys ;;
    backup) backup_server ;;
    remove-mod)
        [[ -n "${2:-}" ]] || die "Verwendung: arma3ctl remove-mod @modordner"
        remove_workshop_mod "$2"
        ;;
    start|stop|restart) require_root; systemctl "$command" "$SERVER_UNIT" ;;
    status) systemctl status "$SERVER_UNIT" --no-pager || true ;;
    logs) journalctl -u "$SERVER_UNIT" -n "${2:-200}" --no-pager -o short-iso ;;
    doctor) doctor ;;
    *) usage; [[ -n "$command" ]] && exit 2 || exit 0 ;;
esac
