#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

CONTROL_ROOT="${CONTROL_ROOT:-/opt/arma3-control}"
ENV_FILE="${ARMA_ENV_FILE:-/etc/arma3/arma3.env}"
[[ -r "$ENV_FILE" ]] || { echo "Konfiguration fehlt: $ENV_FILE" >&2; exit 1; }
# shellcheck disable=SC1090
source "$ENV_FILE"

: "${ARMA_USER:=arma3}"
: "${ARMA_HOME:=/home/arma3}"
: "${SERVER_DIR:=/home/arma3/server}"
: "${STEAMCMD_DIR:=/home/arma3/steamcmd}"
: "${WORKSHOP_DIR:=/home/arma3/workshop}"
: "${BACKUP_DIR:=/home/arma3/backups}"
: "${STATE_DIR:=/home/arma3/state}"
: "${MODS_FILE:=/etc/arma3/mods.csv}"
: "${SERVER_UNIT:=arma3-server.service}"
: "${BACKUP_RETENTION_DAYS:=14}"
: "${FAILED_MODS_FILE:=$STATE_DIR/failed-mods.csv}"
: "${LOCK_FILE:=/run/lock/arma3-control.lock}"

declare -a MOD_FAILURE_NAMES=()
declare -a MOD_FAILURE_IDS=()
declare -a MOD_FAILURE_TARGETS=()
declare -a MOD_FAILURE_STAGES=()
declare -a MOD_FAILURE_REASONS=()
DOWNLOAD_ERROR=""
MOD_UPDATE_RESULT=0

log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
die() { printf 'FEHLER: %s\n' "$*" >&2; exit 1; }

as_arma3() {
    if [[ "$(id -un)" == "$ARMA_USER" ]]; then
        env HOME="$ARMA_HOME" "$@"
    else
        runuser -u "$ARMA_USER" -- env HOME="$ARMA_HOME" "$@"
    fi
}

require_root() {
    [[ $EUID -eq 0 ]] || die "Dieser Befehl muss als root oder über sudo laufen."
}

acquire_maintenance_lock() {
    require_root
    exec 9>"$LOCK_FILE"
    flock -n 9 || die "Eine andere Arma-3-Wartungsaktion läuft bereits."
}

ensure_dirs() {
    require_root
    install -d -o "$ARMA_USER" -g "$ARMA_USER" -m 0750 \
        "$STEAMCMD_DIR" "$SERVER_DIR" "$SERVER_DIR/mods" "$SERVER_DIR/MPMissions" \
        "$WORKSHOP_DIR" "$BACKUP_DIR" "$STATE_DIR" \
        "$ARMA_HOME/.local/share/Arma 3" \
        "$ARMA_HOME/.local/share/Arma 3 - Other Profiles"
}

ensure_steamcmd() {
    ensure_dirs
    if [[ ! -x "$STEAMCMD_DIR/steamcmd.sh" ]]; then
        log "Installiere SteamCMD ..."
        local tmp
        tmp=$(as_arma3 mktemp -p "$STEAMCMD_DIR" .steamcmd.XXXXXX.tar.gz)
        if ! as_arma3 curl -fsSL \
            https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz \
            -o "$tmp"; then
            rm -f "$tmp"
            die "SteamCMD konnte nicht heruntergeladen werden."
        fi
        if ! as_arma3 tar -xzf "$tmp" -C "$STEAMCMD_DIR"; then
            rm -f "$tmp"
            die "SteamCMD-Archiv konnte nicht entpackt werden."
        fi
        rm -f "$tmp"
    fi
}

steam_login_args() {
    if [[ -n "${STEAM_USER:-}" ]]; then
        printf '%s\0%s\0' '+login' "$STEAM_USER"
    else
        printf '%s\0%s\0' '+login' 'anonymous'
    fi
}

steam_update_server() {
    ensure_steamcmd
    local -a login_args=()
    while IFS= read -r -d '' token; do login_args+=("$token"); done < <(steam_login_args)
    timeout --signal=INT --kill-after=30s 1h \
        runuser -u "$ARMA_USER" -- env HOME="$ARMA_HOME" "$STEAMCMD_DIR/steamcmd.sh" \
        +force_install_dir "$SERVER_DIR" \
        "${login_args[@]}" \
        +app_update 233780 validate \
        +quit
}

workshop_source() {
    local id="$1" candidate
    for candidate in \
        "$WORKSHOP_DIR/steamapps/workshop/content/107410/$id" \
        "$STEAMCMD_DIR/steamapps/workshop/content/107410/$id" \
        "$SERVER_DIR/steamapps/workshop/content/107410/$id"; do
        [[ -d "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
    done
    return 1
}

service_was_active=0
stop_for_maintenance() {
    require_root
    service_was_active=0
    if systemctl is-active --quiet "$SERVER_UNIT"; then
        service_was_active=1
        log "Stoppe $SERVER_UNIT für Wartung ..."
        systemctl stop "$SERVER_UNIT"
    fi
}

restart_after_maintenance() {
    if (( service_was_active )); then
        log "Starte $SERVER_UNIT erneut ..."
        systemctl start "$SERVER_UNIT"
    fi
}

sync_keys() {
    require_root
    local keys_dir="$SERVER_DIR/keys"
    local state_file="$STATE_DIR/managed-keys.txt"
    install -d -o "$ARMA_USER" -g "$ARMA_USER" -m 0750 "$keys_dir"

    if [[ -f "$state_file" ]]; then
        while IFS= read -r key; do
            [[ "$key" =~ ^[A-Za-z0-9_.+-]+\.bikey$ ]] && rm -f "$keys_dir/$key"
        done < "$state_file"
    fi

    : > "$state_file"
    chown "$ARMA_USER:$ARMA_USER" "$state_file"

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" ]] && continue
        [[ "$enabled" == "1" ]] || continue
        local mod_dir="$SERVER_DIR/mods/$target"
        [[ -d "$mod_dir" ]] || continue
        while IFS= read -r -d '' key_path; do
            local key_name
            key_name=$(basename "$key_path")
            if [[ -e "$keys_dir/$key_name" ]] && ! cmp -s "$key_path" "$keys_dir/$key_name"; then
                die "Unterschiedliche Keys mit gleichem Namen: $key_name"
            fi
            install -o "$ARMA_USER" -g "$ARMA_USER" -m 0640 "$key_path" "$keys_dir/$key_name"
            grep -qxF "$key_name" "$state_file" || echo "$key_name" >> "$state_file"
        done < <(find "$mod_dir" -type f -iname '*.bikey' -print0)
    done < "$MODS_FILE"

    log "Mod-Keys synchronisiert: $(wc -l < "$state_file")"
}

csv_quote() {
    local value="$1"
    value=${value//$'\r'/ }
    value=${value//$'\n'/ }
    value=${value//\"/\"\"}
    printf '"%s"' "$value"
}

reset_mod_failures() {
    MOD_FAILURE_NAMES=()
    MOD_FAILURE_IDS=()
    MOD_FAILURE_TARGETS=()
    MOD_FAILURE_STAGES=()
    MOD_FAILURE_REASONS=()

    printf '%s\n' 'timestamp,name,workshop_id,target,stage,reason' > "$FAILED_MODS_FILE"
    chown "$ARMA_USER:$ARMA_USER" "$FAILED_MODS_FILE"
    chmod 0640 "$FAILED_MODS_FILE"
}

record_mod_failure() {
    local name="$1" workshop_id="$2" target="$3" stage="$4" reason="$5"

    printf '%s,%s,%s,%s,%s,%s\n' \
        "$(csv_quote "$(date '+%F %T')")" \
        "$(csv_quote "$name")" \
        "$(csv_quote "$workshop_id")" \
        "$(csv_quote "$target")" \
        "$(csv_quote "$stage")" \
        "$(csv_quote "$reason")" >> "$FAILED_MODS_FILE"

    MOD_FAILURE_NAMES+=("$name")
    MOD_FAILURE_IDS+=("$workshop_id")
    MOD_FAILURE_TARGETS+=("$target")
    MOD_FAILURE_STAGES+=("$stage")
    MOD_FAILURE_REASONS+=("$reason")
}

print_mod_failure_summary() {
    local count=${#MOD_FAILURE_NAMES[@]}
    local index

    if (( count == 0 )); then
        log "Alle Workshop-Mods wurden erfolgreich verarbeitet."
        log "Fehlerdatei (nur Kopfzeile): $FAILED_MODS_FILE"
        return 0
    fi

    printf '\n=== Fehlerhafte Mods (%d) ===\n' "$count"
    for ((index=0; index<count; index++)); do
        printf '  - %s (%s) - %s: %s\n' \
            "${MOD_FAILURE_NAMES[$index]}" \
            "${MOD_FAILURE_IDS[$index]}" \
            "${MOD_FAILURE_STAGES[$index]}" \
            "${MOD_FAILURE_REASONS[$index]}"
    done
    printf '\nFehlerdatei: %s\n' "$FAILED_MODS_FILE"
    printf 'Alle übrigen Mods wurden weiterverarbeitet.\n'
}

download_workshop_item() {
    local name="$1" workshop_id="$2"
    shift 2
    local -a login_args=("$@")
    local retries="${WORKSHOP_RETRIES:-4}"
    local retry_delay="${WORKSHOP_RETRY_DELAY:-30}"
    local item_timeout="${WORKSHOP_ITEM_TIMEOUT:-3h}"
    local attempt log_file steam_status last_reason
    local -a validate_arg=()

    [[ "$retries" =~ ^[1-9][0-9]*$ ]] \
        || die "WORKSHOP_RETRIES muss eine positive ganze Zahl sein."
    [[ "$retry_delay" =~ ^[0-9]+$ ]] \
        || die "WORKSHOP_RETRY_DELAY muss eine nichtnegative ganze Zahl sein."
    if [[ "${WORKSHOP_VALIDATE:-0}" == "1" ]]; then
        validate_arg=(validate)
    fi

    DOWNLOAD_ERROR=""
    last_reason="Unbekannter SteamCMD-Fehler"

    for ((attempt=1; attempt<=retries; attempt++)); do
        log "Lade $name ($workshop_id), Versuch $attempt/$retries ..."
        log_file=$(mktemp)

        set +e
        timeout --signal=INT --kill-after=30s "$item_timeout" \
            runuser -u "$ARMA_USER" -- env HOME="$ARMA_HOME" "$STEAMCMD_DIR/steamcmd.sh" \
            +force_install_dir "$WORKSHOP_DIR" \
            "${login_args[@]}" \
            +workshop_download_item 107410 "$workshop_id" "${validate_arg[@]}" \
            +quit 2>&1 | tee "$log_file"
        steam_status=${PIPESTATUS[0]}
        set -e

        if (( steam_status == 0 )) \
            && grep -Fq "Success. Downloaded item $workshop_id" "$log_file" \
            && workshop_source "$workshop_id" >/dev/null; then
            rm -f "$log_file"
            log "Download erfolgreich: $name ($workshop_id)"
            return 0
        fi

        if (( steam_status == 124 || steam_status == 137 )); then
            last_reason="Zeitüberschreitung nach $item_timeout"
        elif (( steam_status != 0 )); then
            last_reason="SteamCMD endete mit Exit-Code $steam_status"
        elif grep -Fq "Success. Downloaded item $workshop_id" "$log_file"; then
            last_reason="SteamCMD meldete Erfolg, aber das Downloadverzeichnis fehlt"
        else
            last_reason="SteamCMD meldete keinen erfolgreichen Download"
        fi

        rm -f "$log_file"
        if (( attempt < retries )); then
            log "Download fehlgeschlagen: $last_reason. Neuer Versuch in ${retry_delay}s ..."
            sleep "$retry_delay"
        fi
    done

    DOWNLOAD_ERROR="$last_reason nach $retries Versuchen"
    log "FEHLER: $name ($workshop_id) konnte nicht geladen werden. Der nächste Mod wird versucht."
    return 1
}

sync_workshop_item() {
    local name="$1" workshop_id="$2" target="$3"
    local source_dir target_dir

    if ! source_dir=$(workshop_source "$workshop_id"); then
        DOWNLOAD_ERROR="Downloadverzeichnis fehlt"
        return 1
    fi

    target_dir="$SERVER_DIR/mods/$target"
    log "Synchronisiere $name -> $target"

    if ! install -d -o "$ARMA_USER" -g "$ARMA_USER" -m 0750 "$target_dir"; then
        DOWNLOAD_ERROR="Zielordner konnte nicht angelegt werden"
        return 1
    fi
    if ! rsync -a --delete "$source_dir/" "$target_dir/"; then
        DOWNLOAD_ERROR="rsync ist fehlgeschlagen"
        return 1
    fi
    if ! chown -R "$ARMA_USER:$ARMA_USER" "$target_dir"; then
        DOWNLOAD_ERROR="Besitzrechte konnten nicht gesetzt werden"
        return 1
    fi
    if ! as_arma3 python3 "$CONTROL_ROOT/scripts/lowercase_tree.py" "$target_dir"; then
        DOWNLOAD_ERROR="Dateinamen konnten nicht kleingeschrieben werden"
        return 1
    fi

    return 0
}

update_mods_core() {
    require_root
    ensure_steamcmd

    local -a login_args=()
    local -A failed_download_ids=()
    local mod_count=0
    local name type workshop_id target enabled
    local result=0
    while IFS= read -r -d '' token; do login_args+=("$token"); done < <(steam_login_args)

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" ]] && continue
        [[ "$enabled" == "1" && "$type" == "workshop" ]] || continue
        [[ "$workshop_id" =~ ^[0-9]+$ ]] || die "Ungültige Workshop-ID für $name"
        [[ "$target" =~ ^@[a-z0-9_+.-]+$ ]] || die "Ungültiger Zielordner für $name: $target"
        ((mod_count+=1))
    done < "$MODS_FILE"

    (( mod_count > 0 )) || die "Keine aktivierten Workshop-Mods gefunden."
    reset_mod_failures
    log "Aktualisiere $mod_count Workshop-Mods einzeln mit Wiederholungsversuchen ..."

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" ]] && continue
        [[ "$enabled" == "1" && "$type" == "workshop" ]] || continue

        if ! download_workshop_item "$name" "$workshop_id" "${login_args[@]}"; then
            failed_download_ids["$workshop_id"]=1
            record_mod_failure "$name" "$workshop_id" "$target" "download" "$DOWNLOAD_ERROR"
            result=1
        fi
    done < "$MODS_FILE"

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" ]] && continue
        [[ "$enabled" == "1" && "$type" == "workshop" ]] || continue
        [[ -z "${failed_download_ids[$workshop_id]:-}" ]] || continue

        if ! sync_workshop_item "$name" "$workshop_id" "$target"; then
            log "FEHLER: $name ($workshop_id) konnte nicht synchronisiert werden. Der nächste Mod wird versucht."
            record_mod_failure "$name" "$workshop_id" "$target" "sync" "$DOWNLOAD_ERROR"
            result=1
        fi
    done < "$MODS_FILE"

    sync_keys
    print_mod_failure_summary

    MOD_UPDATE_RESULT=$result
}

update_mods() {
    require_root
    stop_for_maintenance
    trap restart_after_maintenance EXIT

    update_mods_core

    trap - EXIT
    restart_after_maintenance
    return "$MOD_UPDATE_RESULT"
}

update_server() {
    require_root
    stop_for_maintenance
    trap restart_after_maintenance EXIT
    steam_update_server
    trap - EXIT
    restart_after_maintenance
}

update_all() {
    require_root
    stop_for_maintenance
    trap restart_after_maintenance EXIT

    steam_update_server
    update_mods_core

    trap - EXIT
    restart_after_maintenance
    return "$MOD_UPDATE_RESULT"
}

backup_server() {
    require_root
    ensure_dirs
    local stamp archive stage
    stamp=$(date '+%Y%m%d_%H%M%S')
    archive="$BACKUP_DIR/arma3_${stamp}.tar.gz"
    stage=$(mktemp -d)
    trap 'rm -rf "$stage"' EXIT

    install -d "$stage/server" "$stage/profile" "$stage/local-mods"
    for item in server.cfg basic.cfg ban.txt bans.txt; do
        [[ -e "$SERVER_DIR/$item" ]] && cp -a "$SERVER_DIR/$item" "$stage/server/"
    done
    [[ -d "$SERVER_DIR/MPMissions" ]] && rsync -a "$SERVER_DIR/MPMissions/" "$stage/server/MPMissions/"
    [[ -d "$ARMA_HOME/.local/share/Arma 3 - Other Profiles" ]] && \
        rsync -a "$ARMA_HOME/.local/share/Arma 3 - Other Profiles/" "$stage/profile/"

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" ]] && continue
        [[ "$type" == "local" ]] || continue
        [[ -d "$SERVER_DIR/mods/$target" ]] && rsync -a "$SERVER_DIR/mods/$target" "$stage/local-mods/"
    done < "$MODS_FILE"

    tar -C "$stage" -czf "$archive" .
    chown "$ARMA_USER:$ARMA_USER" "$archive"
    find "$BACKUP_DIR" -maxdepth 1 -type f -name 'arma3_*.tar.gz' -mtime "+$BACKUP_RETENTION_DAYS" -delete
    log "Backup erstellt: $archive ($(du -h "$archive" | cut -f1))"
}

doctor() {
    local errors=0 warnings=0 uppercase
    echo "=== TF133 Arma 3 Diagnose ==="
    printf 'Server-Unit: '; systemctl is-active "$SERVER_UNIT" 2>/dev/null || true
    printf 'Serververzeichnis: %s\n' "$SERVER_DIR"
    printf 'Speicher: '; df -h "$SERVER_DIR" 2>/dev/null | awk 'NR==2 {print $3 " / " $2 " belegt, " $4 " frei"}' || true

    for file in "$SERVER_DIR/arma3server_x64" "$SERVER_DIR/server.cfg" "$SERVER_DIR/basic.cfg" "$MODS_FILE"; do
        if [[ -e "$file" ]]; then echo "OK: $file"; else echo "FEHLT: $file"; ((errors+=1)); fi
    done

    while IFS=, read -r name type workshop_id target enabled; do
        enabled=${enabled%$'\r'}
        [[ "$name" == "name" || "$enabled" != "1" ]] && continue
        if [[ ! -d "$SERVER_DIR/mods/$target" ]]; then
            echo "MOD FEHLT: $name ($target)"
            ((warnings+=1))
        fi
    done < "$MODS_FILE"

    uppercase=$(find "$SERVER_DIR/mods" -mindepth 1 -name '*[A-Z]*' 2>/dev/null | wc -l || true)
    echo "Pfade mit Großbuchstaben unter mods/: $uppercase"
    (( uppercase > 0 )) && ((warnings+=1))

    if command -v ss >/dev/null; then
        echo "UDP-Ports 2302-2306:"
        ss -lun | awk '$5 ~ /:(2302|2303|2304|2305|2306)$/ {print "  " $0}' || true
    fi

    echo "Ergebnis: $errors Fehler, $warnings Warnungen"
    (( errors == 0 ))
}

usage() {
    cat <<'USAGE'
Verwendung: arma3ctl <Befehl>

  steam-login      SteamCMD interaktiv anmelden und Steam Guard bestätigen
  install-server   Dedicated Server installieren oder validieren
  update-server    Server stoppen, aktualisieren und wieder starten
  update-mods      Workshop-Mods aktualisieren, Fehler protokollieren und fortfahren
  update-all       Server und Mods aktualisieren
  sync-keys        Keys der aktivierten Mods synchronisieren
  backup           Konfiguration, Missionen, Profile und lokale Mods sichern
  start|stop|restart|status
  logs [ZEILEN]
  doctor           Installation und Modstruktur prüfen
USAGE
}

command="${1:-}"
case "$command" in
    steam-login|install-server|update-server|update-mods|update-all|sync-keys|backup|start|stop|restart)
        acquire_maintenance_lock
        ;;
esac
case "$command" in
    steam-login)
        require_root; ensure_steamcmd
        [[ -n "${STEAM_USER:-}" ]] || die "STEAM_USER zuerst in $ENV_FILE setzen."
        as_arma3 "$STEAMCMD_DIR/steamcmd.sh" +login "$STEAM_USER"
        ;;
    install-server) require_root; steam_update_server ;;
    update-server) update_server ;;
    update-mods) update_mods ;;
    update-all) update_all ;;
    sync-keys) sync_keys ;;
    backup) backup_server ;;
    start|stop|restart) require_root; systemctl "$command" "$SERVER_UNIT" ;;
    status) systemctl status "$SERVER_UNIT" --no-pager || true ;;
    logs) journalctl -u "$SERVER_UNIT" -n "${2:-200}" --no-pager -o short-iso ;;
    doctor) doctor ;;
    *) usage; [[ -n "$command" ]] && exit 2 || exit 0 ;;
esac
