// Reiner COOP-/PvE-Missionskern. Alle vier Seiten moeglich, aber pro Mission
// genau eine gemeinsame Spieler-Seite (WEST/EAST/GUER/CIV).
author = "DMCS Prototype";
onLoadName = "Dynamic Mission Control System";
respawn = 3;
respawnDelay = 8;
disabledAI = 1;

class DYN_Settings {
    // 3DEN-Marker mit diesen Namen selbst anlegen; nur diese Zonen sind erlaubt.
    zones[] = {"dyn_zone_1", "dyn_zone_2", "dyn_zone_3"};
    // OPTIONAL: Zeus-/Lagedarsteller-UIDs, die auch ohne Serveradmin freigeschaltet werden.
    trustedUIDs[] = {};
    // AUTO nutzt die erste gemeinsame Spieler-Seite, auch CIV ist moeglich.
    // Alternativ fest: WEST, EAST, GUER oder CIV.
    playerSide = "AUTO";
    maxActive = 2;
    maxTasks = 30;
    // Gegnerklassen werden anhand der Spieler-Seite gewaehlt.
    // Anpassen fuer RHS/3CB/BWMod - CfgVehicles-Klassen muessen existieren.
    enemyEastRifle = "O_Soldier_F";
    enemyEastAR = "O_Soldier_AR_F";
    enemyWestRifle = "B_Soldier_F";
    enemyWestAR = "B_Soldier_AR_F";
    // Abhol- und Abgabestation fuer den zivilen Botengang.
    civilDropoffMarker = "dyn_civ_dropoff";
    // Dynamisches Zivilleben: im Hostmenue ein- und ausschaltbar.
    ambientCivEnabled = 0;
    ambientCivMax = 16;
    ambientCivPerPlayer = 2;
    ambientCivClasses[] = {"C_man_1"};
    destroyTarget = "O_Quadbike_01_F";
    rescueTarget = "C_man_1";
    supplyTarget = "Box_NATO_Ammo_F";
};

class CfgFunctions {
    class DYN {
        class Core {
            file = "dyn\functions";
            class authorized {};
            class teamSide {};
            class scenarioGet {};
            class scenarioRefresh {};
            class scenarioSubmit {};
            class civLoop {};
            class interactionAvailable {};
            class interactRequest {};
            class interact {};
            class scale {};
            class publish {};
            class request {};
            class start {};
            class finish {};
            class cleanup {};
            class tick {};
            class uiRefresh {};
            class uiSelect {};
            class uiAction {};
            class feedback {};
        };
    };
};

// Strikte Mission-Whitelist; bei Verwendung weiterer Mods deren RE-Bedarf pruefen.
class CfgRemoteExec {
    class Functions {
        mode = 1;
        jip = 0;
        class DYN_fnc_request { allowedTargets = 2; jip = 0; };
        class DYN_fnc_interact { allowedTargets = 2; jip = 0; };
        class DYN_fnc_feedback { allowedTargets = 1; jip = 0; };
        // Vanilla-Funktionen, die laut BI im Spielkern remote ausgefuehrt werden.
        class BIS_fnc_effectKilledAirDestruction { allowedTargets = 0; jip = 0; };
        class BIS_fnc_effectKilledSecondaries { allowedTargets = 0; jip = 0; };
        class BIS_fnc_fire { allowedTargets = 0; jip = 0; };
        class BIS_fnc_objectVar { allowedTargets = 0; jip = 0; };
        class BIS_fnc_setCustomSoundController { allowedTargets = 0; jip = 0; };
    };
    class Commands { mode = 1; jip = 0; };
};

#include "dyn\dialog.hpp"
#include "dyn\scenarios\catalog.hpp"
